# Market Lens environment variables

# -----------------------------------------------------------------------------
# Browser-safe configuration
# Anything prefixed with VITE_ can be exposed to the browser bundle.
# -----------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Server-only secrets
# NEVER rename these with a VITE_ prefix.
# -----------------------------------------------------------------------------

ALPACA_API_KEY=
ALPACA_API_SECRET=

# Used only by privileged catalog synchronization and other server-side jobs.
SUPABASE_SECRET_KEY=
